{
  "name": "claude-onair",
  "version": "0.1.0",
  "private": true,
  "description": "Physical status light and live broadcast for Claude Code sessions",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "dev:daemon": "pnpm --filter @claude-onair/daemon dev",
    "dev:mod": "pnpm --filter @claude-onair/mod dev"
  },
  "keywords": [
    "claude-code",
    "claude-mods",
    "status-light",
    "blink1",
    "wled",
    "hardware"
  ],
  "author": "Jignesh Dhamecha",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
